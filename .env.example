# Digital Banking Requirements Engineering Assistant Configuration

# Application Environment (development, testing, production)
APP_ENV=development

# LLM Configuration
# Provider options: ollama, mock, openai, gemini
LLM_PROVIDER=fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Optional Cloud API keys (if using openai or gemini providers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# RAG & Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_DB_DIR=data/vector_db
BM25_INDEX_DIR=data/bm25_index

# Chunking Parameters
CHUNK_SIZE_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
MAX_CHUNK_CHAR_LEN=1800

# Retrieval & Fusion Parameters
DENSE_TOP_K=15
BM25_TOP_K=15
RRF_K=60
RERANK_TOP_K=6

# Logging
LOG_LEVEL=INFO
